# Everything here is optional for local development. The defaults match docker-compose.yml.

# PostgreSQL connection. Default: postgres://shop:shop@localhost:5433/thunder_shop
# DATABASE_URL=postgres://shop:shop@localhost:5433/thunder_shop

# Database used by `pnpm test`. It is created automatically and wiped before every test.
# TEST_DATABASE_URL=postgres://shop:shop@localhost:5433/thunder_shop_test
